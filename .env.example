# Required Keycloak configuration
KEYCLOAK_API_KEY_BRIDGE_KEYCLOAK_URL=https://keycloak.example
KEYCLOAK_API_KEY_BRIDGE_KEYCLOAK_REALM=example
KEYCLOAK_API_KEY_BRIDGE_KEYCLOAK_ISSUER=https://keycloak.example/realms/example
KEYCLOAK_API_KEY_BRIDGE_KEYCLOAK_CLIENT_ID=keycloak-api-key-bridge
KEYCLOAK_API_KEY_BRIDGE_KEYCLOAK_CLIENT_SECRET=

# Keycloak and entitlement behavior
KEYCLOAK_API_KEY_BRIDGE_AGENTGATEWAY_CLIENT_ID=agentgateway
KEYCLOAK_API_KEY_BRIDGE_KEYCLOAK_TIMEOUT_SECONDS=1
KEYCLOAK_API_KEY_BRIDGE_JWKS_REFRESH_INTERVAL_SECONDS=10
KEYCLOAK_API_KEY_BRIDGE_JWKS_RETRY_INTERVAL_SECONDS=5
KEYCLOAK_API_KEY_BRIDGE_ENTITLEMENT_CACHE_TTL_SECONDS=30
KEYCLOAK_API_KEY_BRIDGE_NEGATIVE_ENTITLEMENT_CACHE_TTL_SECONDS=5

# Storage and API-key limits
KEYCLOAK_API_KEY_BRIDGE_DATABASE_URL=sqlite:///data/api_keys.db
KEYCLOAK_API_KEY_BRIDGE_MAX_KEYS_PER_USER=20

# Optional secret-volume file paths for managed API keys
KEYCLOAK_API_KEY_BRIDGE_MANAGED_PRIMARY_GRANT_FILE=
KEYCLOAK_API_KEY_BRIDGE_MANAGED_PRIMARY_VERIFIER_FILE=
KEYCLOAK_API_KEY_BRIDGE_MANAGED_SECONDARY_GRANT_FILE=
KEYCLOAK_API_KEY_BRIDGE_MANAGED_SECONDARY_VERIFIER_FILE=

# Server
KEYCLOAK_API_KEY_BRIDGE_HOST=0.0.0.0
KEYCLOAK_API_KEY_BRIDGE_PORT=8000
KEYCLOAK_API_KEY_BRIDGE_LOG_LEVEL=info
